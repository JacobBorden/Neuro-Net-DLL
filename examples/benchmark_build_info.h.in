#pragma once

#include <iostream>
#include <string>

/** Print the CMake build configuration and compiler options used by benchmarks. */
inline void PrintBenchmarkBuildInfo() {
    const std::string config = NEURONET_BUILD_CONFIG;
    std::string config_flags;
    if (config == "Debug") config_flags = R"flags(@CMAKE_CXX_FLAGS_DEBUG@)flags";
    else if (config == "Release") config_flags = R"flags(@CMAKE_CXX_FLAGS_RELEASE@)flags";
    else if (config == "RelWithDebInfo") config_flags = R"flags(@CMAKE_CXX_FLAGS_RELWITHDEBINFO@)flags";
    else if (config == "MinSizeRel") config_flags = R"flags(@CMAKE_CXX_FLAGS_MINSIZEREL@)flags";

    std::cout << "Build configuration: " << config << '\n'
              << "C++ standard: C++@CMAKE_CXX_STANDARD@\n"
              << "C++ flags (common): @CMAKE_CXX_FLAGS@\n"
              << "C++ flags (configuration): " << config_flags << '\n';
#ifdef _OPENMP
    std::cout << "OpenMP compile flags: @OpenMP_CXX_FLAGS@\n";
#endif
}
